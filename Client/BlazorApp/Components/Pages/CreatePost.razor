@page "/create-post"
@using ApiContracts
@using BlazorApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IPostService PostService

<h3>Create new post</h3>

<AuthorizeView>
    <Authorized>
        <div class="mb-3">
            <label>Title</label>
            <input class="form-control" @bind="title" />
        </div>

        <div class="mb-3">
            <label>Body</label>
            <textarea class="form-control" @bind="body"></textarea>
        </div>

        <button class="btn btn-primary" @onclick="CreateNewPost">
            Create Post
        </button>

        @if (!string.IsNullOrEmpty(message))
        {
            <p>@message</p>
        }
    </Authorized>

    <NotAuthorized>
        <p>You must log in to create a post.</p>
        <a href="/login">Log in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string title = "";
    private string body = "";
    private string message = "";

    private async Task CreateNewPost()
    {
        try
        {
            AuthenticationState authState = await AuthState;
            string? id = authState.User.FindFirst("Id")?.Value;

            if (!int.TryParse(id, out int userId))
            {
                message = "You must log in to create a post.";
                return;
            }

            CreatePostDto request = new()
            {
                Title = title,
                Body = body,
                UserId = userId
            };

            PostDto createdPost = await PostService.AddPostAsync(request);

            message = $"Post {createdPost.Id} created successfully!";
            title = "";
            body = "";
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
        }
    }
}